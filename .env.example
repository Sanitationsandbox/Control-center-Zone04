# Postgres connection string. Required everywhere — Prisma is the durable source
# of truth for display control state.
#
# A pooled URL is fine here; Prisma uses it for ordinary queries.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. Control-state changes are fanned out to other server instances with
# Postgres LISTEN/NOTIFY, and LISTEN needs a DIRECT connection — a
# transaction-mode pooler (PgBouncer, Neon's "-pooler" host, Supabase's :6543
# port) accepts the statement and then silently delivers nothing.
#
# Leave this unset and the app derives the direct endpoint by dropping "-pooler"
# from DATABASE_URL, which is correct on Neon. Set it explicitly for any other
# pooler. If no direct connection can be made the app still runs, but a command
# only reaches walls served by the instance that handled it — the server log says
# so loudly.
#
# Note: this holds one long-lived connection per server instance, which keeps a
# Neon compute from auto-suspending. For a 24/7 wall that is the intent anyway.
DIRECT_DATABASE_URL=

# Cloudinary credentials for /api/upload.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
